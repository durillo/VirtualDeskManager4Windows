<UserControl x:Class="VirtualDeskManager.App.Views.Settings.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:VirtualDeskManager.App.Localization"
             xmlns:s="clr-namespace:VirtualDeskManager.App.Views.Settings">
    <StackPanel>

        <s:SettingGroup Header="{l:T HelpPage.FirstSteps}" Margin="0,8,0,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T HelpPage.FirstStepsText}" Style="{StaticResource Body}" LineHeight="22" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{l:T Nav.Desktops}" Command="{x:Static s:SettingsCommands.GoToSection}" CommandParameter="desktops" Margin="0,0,8,8" />
                        <Button Content="{l:T Nav.Hotkeys}" Command="{x:Static s:SettingsCommands.GoToSection}" CommandParameter="hotkeys" Margin="0,0,8,8" />
                        <Button Content="{l:T Nav.Automations}" Command="{x:Static s:SettingsCommands.GoToSection}" CommandParameter="automations" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </s:SettingGroup>

        <s:SettingGroup Header="{l:T HelpPage.InApp}">
            <Border Style="{StaticResource Card}">
                <TextBlock Text="{l:T Page.Help.Help}" Style="{StaticResource Body}" />
            </Border>
        </s:SettingGroup>

        <s:SettingGroup Header="{l:T HelpPage.Troubleshooting}">
            <Border Style="{StaticResource Card}">
                <TextBlock Text="{l:T HelpPage.TroubleshootingText}" Style="{StaticResource Body}" LineHeight="22" />
            </Border>
        </s:SettingGroup>

        <s:SettingGroup Header="{l:T HelpPage.Map}">
            <Border Style="{StaticResource Card}">
                <TextBlock Text="{l:T HelpPage.MapText}" Style="{StaticResource Body}" LineHeight="22" />
            </Border>
        </s:SettingGroup>

    </StackPanel>
</UserControl>
