<UserControl x:Class="VirtualDeskManager.App.Views.Settings.WindowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:VirtualDeskManager.App.Localization"
             xmlns:s="clr-namespace:VirtualDeskManager.App.Views.Settings">
    <!-- Lo que Vdesk pinta encima de las ventanas y de la barra de tareas, y dónde vuelve cada ventana. -->
    <StackPanel>

        <!-- ======================================================== botón en la barra de título -->
        <!-- El tamaño va en porcentaje del natural y no en píxeles: tiene que caber en una barra que
             mide distinto en cada ventana. -->
        <s:SettingGroup Header="{l:T Settings.TitleBarButton}" Margin="0,8,0,0">
            <StackPanel>
                <s:SettingRow Header="{l:T Settings.ShowTitleBarButton}" Description="{l:T Row.TitleBarButton}" Tip="{l:T Row.TitleBarButtonTip}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowTitleBarButton}" />
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.TitleBarButtonSize}" IsEnabled="{Binding ShowTitleBarButton}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource ValueSlider}" Value="{Binding TitleBarButtonSizePercent}" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" />
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding TitleBarButtonSizePercent, StringFormat={}{0}%}" />
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.TitleBarButtonOpacity}" IsEnabled="{Binding ShowTitleBarButton}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource ValueSlider}" Value="{Binding TitleBarButtonOpacityPercent}" Minimum="10" Maximum="100" />
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding TitleBarButtonOpacityPercent, StringFormat={}{0}%}" />
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.TitleBarButtonColour}" IsEnabled="{Binding ShowTitleBarButton}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding ColourPresets}" SelectedItem="{Binding SelectedColourPreset}" Width="160" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                                                BorderBrush="#40808080" BorderThickness="1"
                                                Background="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                                        <TextBlock Text="{Binding Display}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Text="{Binding TitleBarButtonColour, UpdateSourceTrigger=LostFocus}" Width="96" Margin="8,0,0,0"
                                 FontFamily="Consolas" VerticalAlignment="Center" />
                        <!-- Cómo va a quedar de verdad: el color con su transparencia. -->
                        <Border Width="40" Height="28" CornerRadius="4" Margin="8,0,0,0" BorderBrush="#40808080" BorderThickness="1"
                                Background="{Binding TitleBarButtonPreview}" VerticalAlignment="Center" />
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.TitleBarButtonOffset}" Tip="{l:T Settings.TitleBarButtonOffsetHint}" IsEnabled="{Binding ShowTitleBarButton}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource ValueSlider}" Value="{Binding TitleBarButtonOffset}" Minimum="0" Maximum="300" TickFrequency="2" IsSnapToTickEnabled="True" />
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding TitleBarButtonOffset, StringFormat={}{0} px}" />
                    </StackPanel>
                </s:SettingRow>
            </StackPanel>
        </s:SettingGroup>

        <!-- ======================================================== marcas en la barra de tareas -->
        <s:SettingGroup Header="{l:T Group.TaskbarMarks}">
            <StackPanel>
                <s:SettingRow Header="{l:T TaskbarBadges.Enabled}" Description="{l:T Row.TaskbarBadges}"
                              Tip="{l:T TaskbarBadges.Legend}" Help="{l:T TaskbarBadges.Explanation}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TaskbarBadgesEnabled}" />
                </s:SettingRow>
                <!-- El aviso va arriba: con el filtro de Windows puesto, que es el de fábrica, una
                     aplicación de otro escritorio no tiene botón y la función parecería rota. -->
                <Border Style="{StaticResource CautionCard}"
                        Visibility="{Binding TaskbarShowsOnlyCurrentDesktop, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:T TaskbarBadges.FilterWarning}" Style="{StaticResource Body}" />
                </Border>
                <s:SettingRow Header="{l:T TaskbarBadges.HideWhenCurrent}" IsEnabled="{Binding TaskbarBadgesEnabled}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TaskbarBadgesHideWhenCurrent}" />
                </s:SettingRow>
                <s:SettingRow Header="{l:T TaskbarBadges.Size}" IsEnabled="{Binding TaskbarBadgesEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource ValueSlider}" Value="{Binding TaskbarBadgesSizePercent}" Minimum="50" Maximum="200" />
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding TaskbarBadgesSizePercent, StringFormat={}{0}%}" />
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Header="{l:T TaskbarBadges.Opacity}" IsEnabled="{Binding TaskbarBadgesEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource ValueSlider}" Value="{Binding TaskbarBadgesOpacityPercent}" Minimum="20" Maximum="100" />
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding TaskbarBadgesOpacityPercent, StringFormat={}{0}%}" />
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Header="{l:T TaskbarBadges.Colour}" IsEnabled="{Binding TaskbarBadgesEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding TaskbarBadgesColour, UpdateSourceTrigger=LostFocus}" Width="110"
                                 FontFamily="Consolas" VerticalAlignment="Center" />
                        <Border Width="40" Height="28" CornerRadius="4" Margin="8,0,0,0" BorderBrush="#40808080" BorderThickness="1"
                                Background="{Binding TaskbarBadgesColour, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" />
                    </StackPanel>
                </s:SettingRow>
            </StackPanel>
        </s:SettingGroup>

        <!-- ======================================================== posición de las ventanas -->
        <s:SettingGroup Header="{l:T Settings.WindowLayout}">
            <StackPanel>
                <s:SettingRow Header="{l:T Settings.WindowLayoutEnabled}" Description="{l:T Row.WindowLayout}"
                              Help="{l:T Settings.WindowLayoutExplanation}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WindowLayoutEnabled}" />
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.WindowLayoutRestoreAutomatically}" IsEnabled="{Binding WindowLayoutEnabled}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WindowLayoutRestoreAutomatically}" />
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.WindowLayoutRestoreOnStartup}" IsEnabled="{Binding WindowLayoutEnabled}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WindowLayoutRestoreOnStartup}" />
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.WindowLayoutDelay}" Tip="{l:T Row.WindowLayoutDelay}" IsEnabled="{Binding WindowLayoutEnabled}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource ValueSlider}" Value="{Binding WindowLayoutDelayMilliseconds}" Minimum="500" Maximum="10000" TickFrequency="250" IsSnapToTickEnabled="True" />
                        <TextBlock Style="{StaticResource SliderValue}" Text="{Binding WindowLayoutDelayMilliseconds, StringFormat={}{0} ms}" />
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.WindowLayoutRestoreNow}" Description="{Binding WindowLayoutSummary}" IsEnabled="{Binding WindowLayoutEnabled}">
                    <WrapPanel>
                        <Button Content="{l:T Settings.WindowLayoutRestoreNow}" Command="{Binding RestoreLayoutNowCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:T Settings.WindowLayoutForget}" Command="{Binding ForgetLayoutsCommand}" />
                    </WrapPanel>
                </s:SettingRow>
            </StackPanel>
        </s:SettingGroup>

    </StackPanel>
</UserControl>
