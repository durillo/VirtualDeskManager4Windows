<UserControl x:Class="VirtualDeskManager.App.Views.Settings.DesktopsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:VirtualDeskManager.App.Localization"
             xmlns:s="clr-namespace:VirtualDeskManager.App.Views.Settings">
    <StackPanel>

        <s:SettingGroup Header="{l:T Tab.Desktops}" Margin="0,8,0,0">
            <s:SettingCard Header="{l:T Desktops.NamesTitle}" Description="{l:T Desktops.NamesExplanation}">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Desktops}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Desktops.ColumnNumber}" Binding="{Binding Number}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="{l:T Desktops.ColumnName}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{l:T Desktops.YouAreHere}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{l:T Common.Save}" Command="{Binding SaveDesktopNamesCommand}" Margin="0,0,8,0"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="{l:T Common.Refresh}" Command="{Binding RefreshDesktopsCommand}" />
                    </WrapPanel>
                </StackPanel>
            </s:SettingCard>
        </s:SettingGroup>

        <s:SettingGroup Header="{l:T Group.Moving}">
            <StackPanel>
                <s:SettingRow Header="{l:T Settings.FollowMovedWindow}" Description="{l:T Row.FollowMovedWindow}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FollowMovedWindow}" />
                </s:SettingRow>
                <s:SettingRow Header="{l:T Settings.ShowDesktopInTray}" Description="{l:T Row.ShowDesktopInTray}">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowDesktopInTray}" />
                </s:SettingRow>
            </StackPanel>
        </s:SettingGroup>

    </StackPanel>
</UserControl>
