<!-- La ventana Vdesk al estilo de macOS, en claro (pedido el 2026-10-10). Mismas claves que
     TemaMacOscuro.xaml; colores de los Ajustes del Sistema de macOS. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="M.Ventana" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.Lateral" Color="#F2F2F4" />
    <SolidColorBrush x:Key="M.Contenido" Color="#F7F7F9" />
    <SolidColorBrush x:Key="M.Grupo" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.Separador" Color="#E3E3E8" />
    <SolidColorBrush x:Key="M.Borde" Color="#D9D9DE" />
    <SolidColorBrush x:Key="M.Texto" Color="#1D1D1F" />
    <SolidColorBrush x:Key="M.TextoSuave" Color="#86868B" />
    <SolidColorBrush x:Key="M.Acento" Color="#007AFF" />
    <SolidColorBrush x:Key="M.SobreAcento" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.SeleccionLateral" Color="#DCDCE2" />
    <SolidColorBrush x:Key="M.Boton" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.InterruptorApagado" Color="#E3E3E8" />
    <SolidColorBrush x:Key="M.Bola" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.EnLinea" Color="#34C759" />
    <SolidColorBrush x:Key="M.SinConexion" Color="#AEAEB2" />
    <SolidColorBrush x:Key="M.Icono" Color="#007AFF" />
    <SolidColorBrush x:Key="M.FondoIcono" Color="#EEF4FF" />

    <!-- Las claves de Fluent que usan las páginas de ajustes, con los colores de Vdesk: así los
         ajustes, dentro de la ventana Vdesk, se ven como ella (ver PanelAjustes). -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#86868B" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F2F2F4" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E3E3E8" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1A88FF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0062CC" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F7F7F9" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E3E3E8" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E8E8ED" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#007AFF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#007AFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E3E3E8" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#E3E3E8" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
</ResourceDictionary>
