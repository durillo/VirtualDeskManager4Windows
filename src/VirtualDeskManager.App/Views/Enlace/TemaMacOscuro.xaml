<!-- La ventana Vdesk al estilo de macOS, en oscuro. Mismas claves que TemaMacClaro.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="M.Ventana" Color="#1E1E1E" />
    <SolidColorBrush x:Key="M.Lateral" Color="#2A2A2D" />
    <SolidColorBrush x:Key="M.Contenido" Color="#1E1E1E" />
    <SolidColorBrush x:Key="M.Grupo" Color="#2C2C2E" />
    <SolidColorBrush x:Key="M.Separador" Color="#3A3A3C" />
    <SolidColorBrush x:Key="M.Borde" Color="#48484A" />
    <SolidColorBrush x:Key="M.Texto" Color="#F5F5F7" />
    <SolidColorBrush x:Key="M.TextoSuave" Color="#98989D" />
    <SolidColorBrush x:Key="M.Acento" Color="#0A84FF" />
    <SolidColorBrush x:Key="M.SobreAcento" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.SeleccionLateral" Color="#3A3A3E" />
    <SolidColorBrush x:Key="M.Boton" Color="#3A3A3C" />
    <SolidColorBrush x:Key="M.InterruptorApagado" Color="#48484A" />
    <SolidColorBrush x:Key="M.Bola" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.EnLinea" Color="#30D158" />
    <SolidColorBrush x:Key="M.SinConexion" Color="#636366" />
    <SolidColorBrush x:Key="M.Icono" Color="#0A84FF" />
    <SolidColorBrush x:Key="M.FondoIcono" Color="#1C2A3F" />

    <!-- Las claves de Fluent que usan las páginas de ajustes, con los colores de Vdesk: así los
         ajustes, dentro de la ventana Vdesk, se ven como ella (ver PanelAjustes). -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#AEAEB2" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#98989D" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#353538" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2B95FF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0070DD" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#409CFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#3A3A3E" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0A84FF" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#0A84FF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#48484A" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#48484A" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
</ResourceDictionary>
