<Window x:Class="VirtualDeskManager.App.Views.HotkeyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:VirtualDeskManager.App.Localization"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16">

        <TextBlock Text="{l:T HotkeyEditor.Command}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Commands}"
                  SelectedItem="{Binding Command}"
                  DisplayMemberPath="Display" />

        <StackPanel Margin="0,10,0,0" Visibility="{Binding NeedsDesktopNumber, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:T HotkeyEditor.DesktopNumber}" Margin="0,0,0,4" />
            <TextBox Text="{Binding DesktopNumber, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
        </StackPanel>

        <TextBlock Text="{l:T HotkeyEditor.Combination}" Margin="0,12,0,4" />
        <Border x:Name="CaptureBox"
                BorderBrush="#80808080"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,8"
                Focusable="True"
                Cursor="Hand">
            <TextBlock Text="{Binding Combination}" FontWeight="SemiBold" />
        </Border>


        <!-- La segunda combinación, opcional. Sale igual que la primera pero apagada mientras no
             haya una primera: un atajo con segunda y sin primera no significa nada. -->
        <TextBlock Text="{l:T HotkeyEditor.SecondCombination}" Margin="0,12,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AlternateCaptureBox"
                    Grid.Column="0"
                    BorderBrush="#80808080"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,8"
                    Focusable="True"
                    Cursor="Hand"
                    IsEnabled="{Binding CanSetAlternate}">
                <TextBlock Text="{Binding AlternateCombination}" FontWeight="SemiBold" />
            </Border>

            <Button x:Name="ClearAlternateButton"
                    Grid.Column="1"
                    Content="{l:T HotkeyEditor.ClearSecond}"
                    Padding="12,4"
                    Margin="8,0,0,0"
                    Visibility="{Binding HasAlternate, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <TextBlock Text="{l:T HotkeyEditor.SecondCombinationHint}"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   Margin="0,4,0,0" />

        <TextBlock Text="{l:T HotkeyEditor.Id}" Margin="0,12,0,4" />
        <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Content="{l:T Rules.ColumnEnabled}" IsChecked="{Binding Enabled}" Margin="0,12,0,0" />

        <!-- Aviso: no impide guardar. Una tecla sin modificador es asunto de quien tiene el
             teclado delante, pero conviene que sepa que se la quita a todo lo demás. -->
        <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"
                Background="#22B08800"
                BorderBrush="#80B08800"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,8"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
        </Border>

        <!-- Conflicto: dice qué acción tiene ya esa combinación y ofrece quitársela. -->
        <Border Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}"
                Background="#22D13438"
                BorderBrush="#80D13438"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10,8"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ConflictMessage}" TextWrapping="Wrap" />
                <Button x:Name="OverwriteButton"
                        Content="{l:T HotkeyEditor.Overwrite}"
                        Padding="12,4"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Error}"
                   Foreground="#D13438"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton"
                    Content="{l:T Common.Save}"
                    Padding="16,5"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    IsEnabled="{Binding CanSave}" />
            <Button x:Name="CancelButton" Content="{l:T Common.Cancel}" Padding="16,5" IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
